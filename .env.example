# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# --- Servidor ---
PORT=3000
# URL pública que a Twilio consegue alcançar. Use ngrok em dev:
#   ngrok http --domain=<seu-dominio>.ngrok.app 3000
PUBLIC_URL=https://your-domain.ngrok.app

# --- Números Twilio ---
# SID do phone number que atende a chamada (usado pelo scripts/wire-webhook.js
# pra apontar o webhook de voz pro seu servidor).
VOICE_NUMBER_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Números de origem pra envio de link
SMS_FROM=+55XXXXXXXXXXX
WHATSAPP_FROM=whatsapp:+55XXXXXXXXXXX

# --- OpenAI ---
# Chave carregada implicitamente da env OPENAI_API_KEY pelo SDK do OpenAI.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Persona do assistente ---
ASSISTANT_NAME=Sofia
BRAND_NAME=Vox

# --- TTS (Twilio ConversationRelay) ---
# ElevenLabs — voz mais natural. Requer credencial ElevenLabs configurada em
# Twilio Console → Voice → ConversationRelay → Third-party TTS Providers.
# Formato: <voiceId>-<model>. Voice IDs multilíngues:
#   KHmfNHtEjHhLK9eER20w  Fernanda   (feminina, PT-BR, formal e neutra)
#   21m00Tcm4TlvDq8ikWAM  Rachel     (feminina, mais neutra)
#   EXAVITQu4vr4xnSDxMaL  Sarah      (feminina, calorosa)
TTS_PROVIDER=ElevenLabs
TTS_VOICE=KHmfNHtEjHhLK9eER20w-flash_v2_5

# Fallback Amazon Polly (funciona out-of-the-box, sem setup extra):
# TTS_PROVIDER=Amazon
# TTS_VOICE=Camila-Neural

# --- Persistência das personas (opcional) ---
# Caminho para o arquivo JSON com a base mockada de participantes.
# Padrão: ./participantes.json (na raiz do projeto).
# PARTICIPANTES_FILE=./participantes.json
